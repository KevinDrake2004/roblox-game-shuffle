{
  "name": "shuffle",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": "Packages"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Lobby": {
        "$path": "src/map/Lobby.model.json"
      },
      "RocketRunArena": {
        "$path": "src/map/RocketRunArena.model.json"
      },
      "PlinkoArena": {
        "$path": "src/map/PlinkoArena.model.json"
      },
      "MineSweeperArena": {
        "$path": "src/map/MineSweeperArena.model.json"
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0.28, 0.23, 0.43],
        "OutdoorAmbient": [0.19, 0.16, 0.31],
        "Brightness": 1.6,
        "ClockTime": 22.0,
        "FogColor": [0.165, 0.11, 0.282],
        "FogStart": 120.0,
        "FogEnd": 420.0,
        "EnvironmentDiffuseScale": 1.0,
        "EnvironmentSpecularScale": 0.85,
        "GlobalShadows": true,
        "ExposureCompensation": 0.15
      },
      "ShuffleBloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.55,
          "Size": 18.0,
          "Threshold": 0.75
        }
      },
      "ShuffleColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.02,
          "Contrast": 0.08,
          "Saturation": 0.12,
          "TintColor": [0.96, 0.92, 1.0]
        }
      },
      "ShuffleAtmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.08,
          "Offset": 0.05,
          "Color": [0.35, 0.27, 0.55],
          "Decay": [0.22, 0.14, 0.35],
          "Glare": 0.18,
          "Haze": 0.35
        }
      },
      "ShuffleSky": {
        "$className": "Sky",
        "$properties": {
          "CelestialBodiesShown": true,
          "StarCount": 3000,
          "MoonAngularSize": 11.0,
          "SunAngularSize": 12.0
        }
      }
    }
  }
}
